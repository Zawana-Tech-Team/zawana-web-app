    "date-fns": "latest",
    "firebase": "12.19.0",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "latest",
    "recharts": "latest",
    "tailwindcss": "latest",
    "three": "^0.186.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
