VITE_API_URL=http://localhost:8000/api
# Use database-backed usernames/passwords for local development. Set both the
# frontend and backend AUTH_MODE values to "firebase" only when Firebase auth
# is intentionally configured end to end.
VITE_AUTH_MODE=database
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# KPay merchant adapter. The adapter must be backed by the KPay merchant
# credentials/protocol issued to Zawana and return providerReference plus
# checkoutUrl (or qrCode). The KPay webhook must sign the raw JSON body with
# KPAY_WEBHOOK_SECRET and send X-KPay-Signature: sha256=<hex HMAC-SHA256>.
KPAY_CHECKOUT_ADAPTER_URL=
KPAY_ADAPTER_API_KEY=
KPAY_WEBHOOK_SECRET=
KPAY_CALLBACK_URL=
