VITE_API_URL=http://localhost:8000/api

# KPay merchant adapter. The adapter must be backed by the KPay merchant
# credentials/protocol issued to Zawana and return providerReference plus
# checkoutUrl (or qrCode). The KPay webhook must sign the raw JSON body with
# KPAY_WEBHOOK_SECRET and send X-KPay-Signature: sha256=<hex HMAC-SHA256>.
KPAY_CHECKOUT_ADAPTER_URL=
KPAY_ADAPTER_API_KEY=
KPAY_WEBHOOK_SECRET=
KPAY_CALLBACK_URL=
