DATABASE_URL="file:./dev.db"
PORT=8000
CLIENT_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:8000"
AUTH_MODE=database
# Generate a unique random secret with at least 32 characters. Never commit it.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Firebase Admin SDK: use service-account values from a secret manager or
# Application Default Credentials. Never copy these into VITE_* variables.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase PostgreSQL: when ready, set DATABASE_URL to the pooled runtime
# connection and DIRECT_URL to the direct database connection. Generate and
# deploy using the postgres-specific Prisma commands documented in README.
# DATABASE_URL="postgresql://..."
# DIRECT_URL="postgresql://..."

# Firebase Web API key for server-side password verification and recovery.
# Use the existing Firebase project's API key; restrict it to Identity Toolkit.
FIREBASE_WEB_API_KEY=
