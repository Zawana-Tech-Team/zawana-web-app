{
  "name": "zawana-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate && prisma migrate deploy",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate:postgres": "prisma generate --schema prisma/postgresql/schema.prisma",
    "prisma:migrate:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "dev:postgres": "prisma generate --schema prisma/postgresql/schema.prisma && tsx watch src/server.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "prisma validate",
    "prisma:validate:postgres": "prisma validate --schema prisma/postgresql/schema.prisma",
    "prisma:validate:sqlite": "prisma validate --schema prisma/schema.prisma",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "auth:audit": "tsx scripts/audit-auth-identities.ts",
    "auth:migrate-local": "tsx scripts/apply-hybrid-auth-local.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "firebase-admin": "14.5.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "^26.6.5",
    "prisma": "^6.19.3",
    "tsx": "latest",
    "typescript": "latest"
  }
}
