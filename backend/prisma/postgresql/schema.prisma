generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  member
  coach
  admin
  gym_fo
  clinic_fo
  badminton_fo
  store_fo
  cafe_fo
  doctor
  owner
}

enum CourtStatus {
  available
  maintenance
  inactive
}

enum CourtDateOverrideType {
  open
  closed
}

enum BookingKind {
  court
  class
  pt
  recovery
  private_course
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
  CONFIRMED
  COMPLETED
  CANCELLED
  PENDING_COACH_CONFIRMATION
  AWAITING_PAYMENT
  COACH_DECLINED
  EXPIRED
}

enum PaymentStatus {
  pending
  paid
  refunded
}

enum PaymentAttemptStatus {
  INITIATING
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum CoachStatus {
  active
  inactive
}

enum ScheduleRole {
  doctor
}

enum AppointmentStatus {
  pending
  confirmed
  checked_in
  completed
  cancelled
}

enum ProductStatus {
  active
  inactive
}

enum PrivateTrainingStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model CafeMenuItem {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String   @default("")
  price       Int
  available   Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  orderItems  CafeOrderItem[]
}

enum TransactionBusiness {
  Gym
  Badminton
  Clinic
  Store
  Cafe
  Academy
}

model User {
  authIdentities AuthIdentity[]
  authSessions AuthSession[]
  id                   String                @id @default(cuid())
  firebaseUid          String?               @unique
  name                 String
  email                String                @unique
  emailVerified        Boolean               @default(false)
  passwordHash         String?
  role                 Role                  @default(member)
  phone                String?
  membership           String?
  avatar               String?
  createdAt            DateTime              @default(now())
  active               Boolean               @default(true)
  deletedAt            DateTime?
  lastLoginAt          DateTime?
  bookings             Booking[]
  notifications        Notification[]
  badmintonEnrollments BadmintonEnrollment[]
  coachProfile         Coach?
  doctorProfile        Doctor?
  appointments         Appointment[]
  memberships          Membership[]
  transactions         Transaction[]
  storeOrders          StoreOrder[]
  privateTrainingSessions PrivateTrainingSession[] @relation("PrivateTrainingMember")
  createdTrainingSessions PrivateTrainingSession[] @relation("PrivateTrainingCreator")
  cafeOrders           CafeOrder[] @relation("CafeOrderCustomer")
  createdCafeOrders    CafeOrder[] @relation("CafeOrderCreator")
  badmintonPackageCategories BadmintonPackageCategory[] @relation("BadmintonPackageCategoryCreator")
  badmintonPackagePurchases BadmintonPackagePurchase[]
  paymentAttempts       PaymentAttempt[]
  gymEnrollmentMembers GymEnrollmentMember[]
  gymSessionAttendance GymSessionAttendance[]
  courtDateOverrides    CourtDateOverride[]

  @@index([role, active])
  @@index([deletedAt])
}

model Court {
  id        String       @id @default(cuid())
  name      String       @unique
  type      String
  surface   String
  price     Int
  status    CourtStatus  @default(available)
  features  Json
  createdAt DateTime     @default(now())
  bookings  Booking[]
  cafeOrders CafeOrder[]
  blocks    CourtBlock[]
}

model CourtBlock {
  id        String   @id @default(cuid())
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  date      String
  dayOfWeek Int?
  active    Boolean  @default(true)
  start     String
  end       String
  title     String
  type      String   @default("class")
  note      String?
  createdAt DateTime @default(now())

  @@index([courtId, date])
  @@index([courtId, dayOfWeek])
}

model CourtDateOverride {
  id          String                 @id @default(cuid())
  date        String                 @unique
  type        CourtDateOverrideType
  title       String                 @default("Holiday")
  reason      String?
  createdById String?
  createdBy   User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  @@index([date, type])
}

model HolidayRate {
  id        String   @id @default(cuid())
  date      String   @unique
  title     String
  price     Int      @default(30000)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Coach {
  id        String      @id @default(cuid())
  name      String
  specialty String
  department String     @default("Badminton")
  phone     String
  email     String
  status    CoachStatus @default(active)
  color     String      @default("#D6FF3F")
  imageUrl  String?
  userId    String?     @unique
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings  Booking[]
  gymEnrollments GymEnrollment[]
  privateTrainingSessions PrivateTrainingSession[]
  privateCourses PrivateCourse[] @relation("PrivateCourseCoaches")
}

model Doctor {
  id        String      @id @default(cuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty String      @default("Physiotherapy & rehabilitation")
  phone     String      @default("")
  status    CoachStatus @default(active)
  color     String      @default("#79B4FF")
  appointments Appointment[]
  schedules Schedule[]
  createdAt DateTime    @default(now())
}

model Schedule {
  id      String       @id @default(cuid())
  person  String
  role    ScheduleRole
  day     String
  start   String
  end     String
  service String?
  active  Boolean      @default(true)
  doctorId String?
  doctor Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
}

model Booking {
  changes BookingChangeHistory[]
  cancellationRequests BookingCancellationRequest[]
  attendance BookingAttendance?
  id                   String        @id @default(cuid())
  code                 String        @unique
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                 BookingKind
  title                String
  date                 String
  time                 String
  location             String
  status               BookingStatus @default(pending)
  price                Int
  courtId              String?
  court                Court?        @relation(fields: [courtId], references: [id], onDelete: SetNull)
  coachId              String?
  coach                Coach?        @relation(fields: [coachId], references: [id], onDelete: SetNull)
  meta                 String?
  paymentStatus        PaymentStatus @default(pending)
  reservationExpiresAt DateTime?
  coachAcceptedAt      DateTime?
  paymentExpiresAt     DateTime?
  createdAt            DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([courtId, date, status])
  @@index([coachId, date, status])
  @@index([kind, status, paymentExpiresAt], map: "Booking_privateCourse_paymentExpiresAt_idx")
}

model PrivateTrainingSession {
  enrollmentId String?
  enrollment GymEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  requestKey String?
  attendance GymSessionAttendance[]
  debit GymSessionDebit?
  id               String                @id @default(cuid())
  memberId         String
  member           User                  @relation("PrivateTrainingMember", fields: [memberId], references: [id], onDelete: Cascade)
  coachId          String
  coach            Coach                 @relation(fields: [coachId], references: [id], onDelete: Restrict)
  date             String
  startTime        String
  endTime          String
  durationMinutes  Int                   @default(60)
  status           PrivateTrainingStatus @default(SCHEDULED)
  notes            String?
  createdById      String
  createdBy        User                  @relation("PrivateTrainingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt

  @@unique([enrollmentId, requestKey])
  @@index([enrollmentId, status])
  @@index([memberId, date, status])
  @@index([coachId, date, status])
}

model PrivateCourse {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  duration    Int      @default(60)
  price       Int
  status      String   @default("active")
  imageUrl    String?
  category    String   @default("Private Training")
  coaches     Coach[]  @relation("PrivateCourseCoaches")
  createdAt   DateTime @default(now())

  @@index([status, title])
}

model Class {
  id       String @id @default(cuid())
  title    String
  coach    String
  time     String
  duration Int
  capacity Int
  booked   Int    @default(0)
  level    String
  location String
  price    Int
}

model MembershipPlan {
  id       String @id @default(cuid())
  title    String
  price    Int
  duration Int
  kind     String
  features Json
  status   String @default("active")
}

model Membership {
  enrollmentId String? @unique
  enrollment GymEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  accessMode String @default("sessions")
  id          String  @id @default(cuid())
  customerId  String
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer    String
  phone       String
  packageId   String
  package     String
  startDate   String
  expiryDate  String
  status      String
  lastCheckIn String?
  sessionsTotal     Int      @default(0)
  sessionsRemaining Int      @default(0)
  checkIns          GymCheckIn[]
}

model GymCheckIn {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  date         String
  time         String
  sessionsUsed Int        @default(1)
  staffId      String?
  note         String?
  createdAt    DateTime   @default(now())

  @@unique([membershipId, date])
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String
  price                 Int
  category              String
  categoryId            String?
  categoryRef           ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description           String
  sku                   String                 @unique
  barcode               String                 @unique
  stock                 Int                    @default(0)
  cost                  Int                    @default(0)
  tax                   Int                    @default(0)
  status                ProductStatus          @default(active)
  imageUrl              String?
  inventoryTransactions InventoryTransaction[]
}

model InventoryTransaction {
  id        String  @id @default(cuid())
  productId String
  type      String
  quantity  Int
  note      String
  date      String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StoreOrder {
  id       String  @id @default(cuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer String
  total    Int
  discount Int     @default(0)
  tax      Int     @default(0)
  paid     Int
  dueDate  String?
  status   String
  items    Json
}

model CafeOrder {
  id            String          @id @default(cuid())
  orderNumber   String?         @unique
  customerId    String?
  customerUser  User?           @relation("CafeOrderCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  customer      String
  items         Json
  orderItems    CafeOrderItem[]
  location      String          @default("Cafe")
  floor         String          @default("Ground Floor")
  courtId       String?
  court         Court?          @relation(fields: [courtId], references: [id], onDelete: SetNull)
  orderTime     String
  paymentMethod String
  paymentStatus String          @default("pending")
  subtotal      Int             @default(0)
  discount      Int             @default(0)
  tax           Int             @default(0)
  total         Int             @default(0)
  status        String          @default("NEW")
  createdById   String?
  createdBy     User?           @relation("CafeOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  transactionId String?         @unique
  transaction   Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([location, createdAt])
}

model CafeOrderItem {
  id         String        @id @default(cuid())
  orderId    String
  order      CafeOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   CafeMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name       String
  quantity   Int
  unitPrice  Int
  notes      String?
  createdAt  DateTime      @default(now())

  @@index([orderId])
  @@index([menuItemId])
}

model Transaction {
  id            String              @id @default(cuid())
  userId        String?
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  date          String
  customer      String
  business      TransactionBusiness
  item          String
  amount        Int
  discount      Int
  tax           Int
  finalAmount   Int
  paymentMethod String
  staff         String
  status        String
  createdAt     DateTime            @default(now())
  gymEnrollment GymEnrollment?
  cafeOrder     CafeOrder?

  @@index([userId, date])
  @@index([business, status, date])
}

model Appointment {
  id            String            @id @default(cuid())
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  doctorId      String?
  doctorProfile Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  patient       String
  doctor        String
  date          String
  time          String
  type          String
  status        AppointmentStatus @default(pending)
  notes         String?
  paymentStatus PaymentStatus     @default(pending)
}

model Student {
  id            String @id @default(cuid())
  name          String
  phone         String
  className     String
  coach         String
  package       String
  paymentStatus String
  attendance    Int
  expiryDate    String
  status        String
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  audience  String?
  type      String?
  icon      String?
  imageUrl  String?
  actionLabel String?
  entityType String?
  entityId String?
  activeInInbox Boolean @default(true)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BadmintonPackage {
  id             String @id @default(cuid())
  title          String
  price          Int
  sessions       Int
  validity       Int
  description    String
  status         String @default("active")
  categoryId     String?
  category       BadmintonPackageCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  availableDays  Json?
  availableFrom  String?
  availableUntil String?
  scheduleNotes  String?
  courtRules     String?
  imageUrl       String?
  purchases      BadmintonPackagePurchase[]

  @@index([categoryId, status])
}

model BadmintonPackagePurchase {
  id            String @id @default(cuid())
  code          String @unique
  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId     String
  package       BadmintonPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  packageName   String
  price         Int
  paymentMethod String @default("KPay")
  status        String @default("PENDING")
  createdAt     DateTime @default(now())
  paidAt        DateTime?
  enrollment    BadmintonEnrollment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  reference         String               @unique
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType      String
  resourceId        String
  amount            Int
  currency          String               @default("MMK")
  provider          String               @default("KPay")
  providerReference String?              @unique
  checkoutUrl       String?
  qrCode            String?
  status            PaymentAttemptStatus @default(INITIATING)
  expiresAt         DateTime
  paidAt            DateTime?
  failureReason     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([status, expiresAt])
}

model BadmintonPackageCategory {
  code String? @unique
  id        String @id @default(cuid())
  name      String @unique
  active    Boolean @default(true)
  createdBy String?
  creator   User? @relation("BadmintonPackageCategoryCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  packages  BadmintonPackage[]
  createdAt DateTime @default(now())
}

model BadmintonEnrollment {
  categoryCode String?
  @@index([userId, categoryCode, status, expiryDate])
  id                String             @id @default(cuid())
  studentId         String
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentName       String
  phone             String
  packageId         String
  packageName       String
  sessionsTotal     Int
  sessionsRemaining Int
  startDate         String
  expiryDate        String
  status            String             @default("active")
  renewalCount      Int                @default(0)
  lastCheckIn       String?
  purchaseId        String?            @unique
  purchase          BadmintonPackagePurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  checkIns          BadmintonCheckIn[]

  @@index([studentId])
  @@index([userId])
  @@index([expiryDate, status])
}

model BadmintonCheckIn {
  memberId String?
  categoryCode String?
  attendanceKey String? @unique
  source String @default("STAFF")
  actorId String?
  qrId String?
  qr BadmintonEntryQr? @relation(fields: [qrId], references: [id], onDelete: Restrict)
  qrVisit BadmintonQrVisit?
  @@index([memberId, categoryCode, date])
  // One guard per enrollment/day; extra historical visits retain a null guard.
  dailyKey String? @unique
  status String @default("present")
  packageSnapshot String?
  id           String              @id @default(cuid())
  enrollmentId String
  enrollment   BadmintonEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         String
  time         String
  sessionsUsed Int                 @default(1)
  staffId      String?
  note         String?
  createdAt    DateTime            @default(now())

  @@index([enrollmentId, date])
}

model GymPackage {
  kind String @default("MEMBERSHIP")
  rate Int @default(0)
  months Int @default(0)
  validityDays Int @default(90)
  sessionMinutes Int @default(60)
  minMembers Int @default(1)
  maxMembers Int @default(1)
  coachRequired Boolean @default(false)
  version Int @default(1)
  revisions GymPackageRevision[]
  enrollments GymEnrollment[]
  id          String @id @default(cuid())
  title       String
  price       Int
  duration    Int
  sessions    Int    @default(0)
  description String
  benefits    Json
  status      String @default("active")
}

model ContentItem {
  id             String @id @default(cuid())
  kind           String @default("community")
  category       String @default("Milestones")
  body           String @default("")
  title          String
  image          String
  description    String
  googleFormLink String
  status         String @default("draft")
  publishDate    String

  @@index([kind, status, publishDate])
}

model AuthIdentity {
  id String @id @default(cuid())
  userId String
  kind String
  value String
  verifiedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([kind, value])
  @@index([userId])
}

model AuthChallenge {
  id String @id @default(cuid())
  tokenHash String @unique
  proofKey String @unique
  firebaseUid String
  phone String
  authTime Int
  intent String
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
}

model PendingRegistration {
  id String @id @default(cuid())
  tokenHash String @unique
  firebaseUid String @unique
  phoneUid String?
  phone String?
  name String @default("")
  email String @default("")
  credentialsStarted Boolean @default(false)
  credentialsReady Boolean @default(false)
  completedUserId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuthSession {
  id String @id @default(cuid())
  userId String
  accessHash String @unique
  accessExpiresAt DateTime
  expiresAt DateTime
  revokedAt DateTime?
  method String
  proofs String
  authenticatedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens AuthRefreshToken[]
  @@index([userId])
}

model AuthRefreshToken {
  id String @id @default(cuid())
  sessionId String
  tokenHash String @unique
  consumedAt DateTime?
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AuthAbuseCounter {
  key String @id
  count Int @default(0)
  expiresAt DateTime
}

model AuthSecurityEvent {
  id String @id @default(cuid())
  userId String?
  kind String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

// Retry receipts are committed atomically with the bookings. No payment transaction.
model BookingSubmission {
  userId String
  key String
  payloadHash String
  bookingIds String
  createdAt DateTime @default(now())
  @@id([userId, key])
}


model GymPackageRevision {
  id String @id @default(cuid())
  packageId String
  package GymPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  version Int
  snapshot Json
  actorId String?
  createdAt DateTime @default(now())
  @@unique([packageId, version])
}

model GymEnrollment {
  id String @id @default(cuid())
  code String @unique
  packageId String
  package GymPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  packageVersion Int
  snapshot Json
  kind String
  totalPrice Int
  sessionsTotal Int
  sessionsRemaining Int
  status String @default("PENDING_PAYMENT")
  startDate String
  expiryDate String
  coachId String?
  coach Coach? @relation(fields: [coachId], references: [id], onDelete: Restrict)
  createdById String
  requestKey String
  payloadHash String
  renewalOfId String?
  renewalOf GymEnrollment? @relation("GymRenewal", fields: [renewalOfId], references: [id], onDelete: Restrict)
  renewals GymEnrollment[] @relation("GymRenewal")
  transactionId String? @unique
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  paymentMethod String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  members GymEnrollmentMember[]
  sessions PrivateTrainingSession[]
  membership Membership?
  debits GymSessionDebit[]
  @@unique([createdById, requestKey])
  @@index([renewalOfId])
  @@index([status, expiryDate])
  @@index([packageId, createdAt])
}

model GymEnrollmentMember {
  enrollmentId String
  enrollment GymEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([enrollmentId, userId])
  @@index([userId])
}

model GymSessionAttendance {
  sessionId String
  session PrivateTrainingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  status String @default("EXPECTED")
  @@id([sessionId, userId])
}

model GymSessionDebit {
  sessionId String @id
  session PrivateTrainingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  enrollmentId String
  enrollment GymEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  actorId String
  createdAt DateTime @default(now())
}

model GymAuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  entityType String
  entityId String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}

// A single immutable check-in per paid private-course booking.
model BookingAttendance {
  status String @default("present")
  notes String?
  id String @id @default(cuid())
  bookingId String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  recordedById String
  checkedInAt DateTime @default(now())
}

model BadmintonEntryQr {
  categoryCode String?
  createdAt DateTime? @default(now())
  visits BadmintonQrVisit[]
  checkIns BadmintonCheckIn[]
  id String @id @default(cuid())
  tokenHash String @unique
  createdById String
  expiresAt DateTime
  revokedAt DateTime?
}
model BadmintonQrVisit {
  categoryCode String?
  qrId String?
  qr BadmintonEntryQr? @relation(fields: [qrId], references: [id], onDelete: Restrict)
  checkIn BadmintonCheckIn @relation(fields: [checkInId], references: [id], onDelete: Restrict)
  id String @id @default(cuid())
  userId String
  date String
  checkInId String @unique
  @@unique([userId, categoryCode, date])
}

model AttendanceModification {
  id String @id @default(cuid())
  bookingId String
  actorId String
  reason String
  previous String
  current String
  createdAt DateTime @default(now())
  @@index([bookingId, createdAt])
}

model BookingChangeHistory {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  action String
  previous String
  current String
  requestedById String
  approvedById String?
  reason String
  policyException Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([bookingId, createdAt])
}

model BookingCancellationRequest {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  requestedById String
  reason String
  status String @default("requested")
  refundStatus String @default("manual_review")
  reviewedById String?
  reviewReason String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([bookingId, createdAt])
}
